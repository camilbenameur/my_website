# Production build settings (committed on purpose).
# The FormSubmit endpoint is not a secret: Vite inlines it into the public JS bundle.
# It uses the FormSubmit alias (random string) instead of the email address, so the
# address is not exposed to scrapers.
VITE_FORMSUBMIT_URL=https://formsubmit.co/ajax/a2c7757fb99f8962d7547dc71c911fe6

# Optional public email shown under the form. Left empty to limit scraping.
VITE_CONTACT_EMAIL=
