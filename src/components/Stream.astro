---
// The hero's terminal: the profile as JSON, streamed in chunks like an LLM answer. Its last lines are
// "slots": each one stops mid-word and is repaired (open string and brackets closed, in the spirit of
// go-llm-stream's healer), then keeps streaming other true values at rest, several lines at once.
// The HTML already holds the final, repaired state: that is what crawlers, no-JS visitors and
// reduced-motion visitors see. motion/stream.ts replays it chunk by chunk.
// The timings printed next to each field and in the footer are the replay's own (STEP per chunk),
// so they are true by construction.
import { stream, ui } from '../data/site';
import { tr, type Lang } from '../i18n';
import { inline, lex, lineClosers } from '../lib/json-heal';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = stream[lang] as Record<string, unknown>;

type Kind = 'p' | 'k' | 's' | 'n' | 'cut' | 'heal';
type Tok = { k: Kind; t: string };
type Line = { toks: Tok[]; mark?: string; lead?: boolean; slot?: number };

const q = (s: string) => `"${s}"`;
const p = (t: string): Tok => ({ k: 'p', t });
const key = (k: string): Tok[] => [{ k: 'k', t: q(k) }, p(': ')];
const val = (v: unknown): Tok => (typeof v === 'number' ? { k: 'n', t: String(v) } : { k: 's', t: q(String(v)) });
const list = (xs: unknown[]): Tok[] => [p('['), ...xs.flatMap((x, i) => (i ? [p(', '), val(x)] : [val(x)])), p(']')];

const keys = Object.keys(d);
const lines: Line[] = [{ toks: [{ k: 'p', t: '{' }] }];
for (const k of keys) {
  const v = d[k];
  if (k === 'experience' && Array.isArray(v)) {
    lines.push({ toks: [p('  '), ...key(k), p('[')] });
    const [a, b] = v as Record<string, unknown>[];
    const ak = Object.keys(a);
    lines.push({ toks: [p('    { '), ...key(ak[0]), val(a[ak[0]]), p(', '), ...key(ak[1]), val(a[ak[1]]), p(',')] });
    lines.push({ toks: [p('      '), ...key(ak[2]), val(a[ak[2]]), p(',')] });
    lines.push({ toks: [p('      '), ...key(ak[3]), val(a[ak[3]]), p(' },')], lead: true });
    const bk = Object.keys(b);
    lines.push({ toks: [p('    { '), ...bk.flatMap((x, j) => [...(j ? [p(', ')] : []), ...key(x), val(b[x])]), p(' }')] });
    lines.push({ toks: [p('  ],')], mark: 'experience' });
    continue;
  }
  lines.push({ toks: [p('  '), ...key(k), ...(Array.isArray(v) ? list(v) : [val(v)]), p(',')], mark: k });
}

// The slots. Each one is a line `"key": value`; its first value is in the HTML, stopped at `stop` (in
// the middle of its last word, or right after it for the second slot) and healed. The last slot also closes the
// root object. motion/stream.ts replays the others from `texts`. Widths, in characters of one window
// line: 52 fit at 1024 px (the narrowest two-column layout), 41 on a 375 px phone.
const WIDE = 52;
const NARROW = 41;
const slotDefs = stream.slots[lang].map(({ key: k, values }, i, all) => {
  const texts = values.map((v) => `${JSON.stringify(k)}: ${inline(v)}`);
  const from = JSON.stringify(k).length + 2;
  const strings = lex(texts[0]).filter((t) => t.k === 's');
  const w = strings[strings.length - 1];
  const whole = i === 1;
  const stop = whole ? w.at + w.t.length : w.at + 1 + Math.max(2, Math.round((w.t.length - 2) * 0.6));
  // a line is the indent, the text and its comma (or the root's brace): one line of the window
  const size = (x: string) => x.length + 3;
  const narrow = texts.flatMap((x, j) => (size(x) <= NARROW ? [j] : []));
  const long = texts.find((x) => size(x) > WIDE);
  if (long) throw new Error(`stream.slots: "${long}" is longer than ${WIDE} characters and would wrap at 1024 px`);
  if (narrow[0] !== 0 || narrow.length < 2) throw new Error(`stream.slots.${k}: the first value and one other must fit ${NARROW} characters (phones)`);
  return { texts, from, stop, narrow, root: i === all.length - 1, comma: i < all.length - 1 };
});
for (const [i, sd] of slotDefs.entries()) {
  const toks: Tok[] = [p('  '), ...lex(sd.texts[0].slice(0, sd.stop)).map((t): Tok => ({ k: t.open ? 'cut' : t.k, t: t.t }))];
  toks.push({ k: 'heal', t: lineClosers(sd.texts[0].slice(0, sd.stop), sd.root) });
  if (sd.comma) toks.push({ k: 'heal', t: ',' });
  lines.push({ toks, slot: i });
}
// Each slot reserves the room of its longest value, so a longer one never pushes the page (CLS). A cut
// and healed line is never longer than the whole one: the healer adds back the quote and brackets the
// cut removed, the missing letters never come back.
// On phones the slot only uses its short values, so it reserves the longest of those.
const sizer = (sd: (typeof slotDefs)[number], only?: number[]) => {
  const pool = only ? only.map((j) => sd.texts[j]) : sd.texts;
  return `  ${pool.reduce((a, b) => (b.length > a.length ? b : a))}${sd.comma ? ',' : '}'}`.replace(/&/g, '&amp;').replace(/</g, '&lt;');
};
const slotsData = slotDefs.map(({ texts, from, stop, narrow, root, comma }) => ({ texts, from, stop, narrow, root, comma }));

// Chunking: 2 to 6 characters, deterministic, like tokens of a model's output.
const STEP = 0.0055; // seconds per chunk in the replay (motion/stream.ts reads data-step)
let n = 0;
const sizes = [3, 5, 2, 4, 6, 3, 4, 2, 5];
const html = lines.map((line) => {
  let out = '';
  for (const tok of line.toks) {
    if (tok.k === 'heal') { out += `<span class="tk ${tok.t === ',' ? 'p' : 'heal'}" data-heal>${tok.t}</span>`; continue; }
    let rest = tok.t;
    while (rest.length) {
      const size = sizes[n % sizes.length];
      const part = rest.slice(0, size);
      rest = rest.slice(size);
      out += `<span class="c tk ${tok.k}" data-i="${n++}"${line === lines[0] ? ' data-root' : ''}>${part.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`;
    }
  }
  let ok = '';
  if (line.mark) {
    const at = n - 1;
    const s = ((at + 1) * STEP + 0.05).toFixed(2).replace('.', lang === 'fr' ? ',' : '.');
    ok = `<span class="ok" data-at="${at}"${line.mark === 'experience' ? ' data-mark-lead' : ''}><svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M2 6.4 4.8 9 10 3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span>${s} s</span></span>`;
  }
  if (line.slot !== undefined) {
    const sd = slotDefs[line.slot];
    return `<span class="ln"><span class="ln__c"><span class="slot" data-slot="${line.slot}"><span class="slot__size">${sizer(sd)}</span><span class="slot__size slot__size--narrow">${sizer(sd, sd.narrow)}</span><span class="slot__live">${out}</span></span></span></span>`;
  }
  return `<span class="ln"><span class="ln__c">${out}</span>${ok}</span>`;
});
const total = n;
const seconds = (total * STEP + 0.05).toFixed(1).replace('.', lang === 'fr' ? ',' : '.');
const tab = lang === 'fr' ? stream.tab : stream.tabEn;
---
<figure class="stream win" data-stream data-step={STEP} data-total={total} data-slots={JSON.stringify(slotsData)} aria-labelledby="stream-cap">
  <div class="win__bar">
    <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win__title">{tab}</span>
    <span class="stream__badge">{tr(stream.label, lang)}</span>
    <a class="win__meta stream__lib link tap" href="https://github.com/camilbenameur/go-llm-stream" target="_blank" rel="noopener">go-llm-stream<span class="sr-only"> {tr(ui.newTab, lang)}</span></a>
  </div>
  <pre class="stream__pre" aria-hidden="true" translate="no"><span class="ln stream__cmd"><span class="ln__c"><span class="pr">$</span> {tr(stream.command, lang)}</span></span><Fragment set:html={html.join('')} /><span class="ln"><span class="ln__c"><span class="stream__heal-note" data-heal-note><svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3 1.5v5.5h6.5M7 4.5 9.5 7 7 9.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg> {tr(stream.healed, lang)}</span><span class="stream__cursor" aria-hidden="true"></span></span></span></pre>
  <figcaption class="stream__foot" id="stream-cap">
    <span class="stream__stats mono"><b class="tnum">{total}</b> {tr(stream.chunks, lang)} · <b class="tnum">{seconds} s</b></span>
    <span class="stream__note">{tr(stream.foot, lang)}</span>
    <span class="stream__ctl">
      <button class="stream__replay mono" type="button" data-idle-toggle aria-pressed="false" hidden data-on={tr(stream.pause, lang)} data-off={tr(stream.resume, lang)}>{tr(stream.pause, lang)}</button>
      <button class="stream__replay mono" type="button" data-stream-replay hidden>{tr(stream.replay, lang)} <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M10 6a4 4 0 1 1-1.2-2.9M10 1.5v2.4H7.6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
    </span>
  </figcaption>
</figure>

<style>
  .stream { position: relative; }
  .stream__badge { padding: 1px 7px; border: 1px solid var(--border-strong); border-radius: 4px; font-size: 11px; color: var(--muted); }
  .stream__lib { font-size: 12px; text-decoration-color: var(--border-strong); }
  .stream__pre { margin: 0; padding: 18px 20px 14px; font-size: clamp(11.5px, 0.55rem + 0.42vw, 13.6px); line-height: 1.62; color: var(--text-2); white-space: pre; overflow: hidden; tab-size: 2; }
  .stream__cmd { color: var(--fg); margin-bottom: 2px; }
  .stream__pre :global(.ln) { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 2ch; }
  .stream__pre :global(.ln__c) { min-width: 0; }
  .pr { color: var(--muted); }
  .stream__pre :global(.k) { color: var(--blue); }
  .stream__pre :global(.s) { color: var(--green); }
  .stream__pre :global(.n) { color: var(--yellow); }
  .stream__pre :global(.p) { color: var(--muted); }
  .stream__pre :global(.cut) { color: var(--red); background: rgb(255 138 138 / 0.12); border-radius: 2px; }
  .stream__pre :global(.heal) { color: var(--magenta); }
  /* a slot: the live line over an invisible copy of its longest value, in the same grid cell */
  .stream__pre :global(.slot) { display: grid; }
  .stream__pre :global(.slot > *) { grid-area: 1 / 1; min-width: 0; }
  .stream__pre :global(.slot__size) { visibility: hidden; }
  .stream__pre :global(.slot__size--narrow) { display: none; }
  @media (max-width: 599px) {
    .stream__pre :global(.slot__size) { display: none; }
    .stream__pre :global(.slot__size--narrow) { display: block; }
  }
  .stream__pre :global(.slot__caret) { display: inline-block; width: 0.55em; height: 1.05em; margin-left: 1px; vertical-align: -0.18em; background: var(--green); opacity: 0.85; }
  /* when a slot is healed, each added character and the bracket it closes light up together */
  .stream__pre :global(.pair) { border-radius: 2px; animation: pair 1s var(--e-out); }
  .stream__pre :global(.heal.pair) { display: inline-block; animation: pair 1s var(--e-out), healin 0.28s var(--e-out); }
  @keyframes pair { from { background-color: rgb(232 160 208 / 0.3); color: var(--fg); } }
  @keyframes healin { from { opacity: 0; transform: translateY(-0.3em); } }
  .stream__pre :global(.ok) { display: inline-flex; align-items: center; gap: 5px; color: var(--green); }
  .stream__pre :global(.ok span) { color: var(--muted); }
  .stream__heal-note { display: inline-flex; align-items: center; gap: 5px; color: var(--magenta); margin-left: 1ch; vertical-align: -0.15em; }
  .stream__cursor { display: inline-block; width: 0.6em; height: 1.1em; margin-left: 1ch; vertical-align: -0.2em; background: var(--green); }
  .motion .stream__cursor { animation: blink 1.1s steps(1) infinite; }
  :global(.idle-paused) .stream__cursor { animation: none; }
  @keyframes blink { 50% { opacity: 0; } }
  .stream__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 10px 20px 14px; border-top: 1px dashed var(--border); font-size: 12.5px; color: var(--muted); }
  .stream__stats b { color: var(--fg); font-weight: 500; }
  .stream__note { flex: 1 1 16rem; line-height: 1.45; }
  .stream__ctl { display: flex; gap: 8px; margin-left: auto; }
  .stream__replay { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 10px; border: 1px solid var(--border-strong); border-radius: var(--r-chip); background: transparent; color: var(--blue); font-size: 12px; cursor: pointer; transition: background-color var(--d-fast) var(--e-out), color var(--d-fast) var(--e-out); }
  .stream__replay:hover { background: var(--fg); color: var(--bg); }
  /* hidden until the stream has played, but in place: showing them never moves the page (CLS) */
  .stream__replay[hidden] { display: inline-flex !important; visibility: hidden; }
  .stream__replay svg { transition: transform 0.3s var(--e-out); }
  .stream__replay:hover svg { transform: rotate(-200deg); }
  /* replay states, set by motion/stream.ts */
  .stream.is-playing :global(.c:not(.on)), .stream.is-playing :global(.ok:not(.on)), .stream.is-playing :global([data-heal]:not(.on)), .stream.is-playing .stream__heal-note:not(.on), .stream.is-playing .stream__cursor { visibility: hidden; }
  .stream :global(.ok.on) { animation: tick 0.3s var(--e-out); }
  @keyframes tick { from { opacity: 0; transform: translateX(-4px); } }
  @media (max-width: 1023px) { .stream__pre { white-space: pre-wrap; word-break: break-word; } }
</style>
