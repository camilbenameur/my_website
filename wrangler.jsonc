{
  // camilbenameur.com: a static site served by Workers static assets.
  // Deployed by .github/workflows/deploy.yml: `npm run build`, then `wrangler deploy` on main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mywebsite",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
