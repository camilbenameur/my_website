# Copy to .env.local for local overrides (ignored by git).
# Production values live in .env.production, which is committed: the FormSubmit
# endpoint ends up in the public JS bundle anyway, and a production build fails
# if it is missing.

# FormSubmit endpoint (alias form): https://formsubmit.co/ajax/<random-string>
VITE_FORMSUBMIT_URL=

# Optional: show a public email address in the UI. Leave empty to reduce scraping.
VITE_CONTACT_EMAIL=
